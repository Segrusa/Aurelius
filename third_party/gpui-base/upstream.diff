 /// may hold a `ScrollHandle`.
 pub(crate) type RevealHandlerFn = dyn Fn(Bounds<Pixels>, &mut Window, &mut App);
 
+type LinkHoverHandlerFn = dyn Fn(Option<SharedString>, &mut Window, &mut App);
+
+struct LinkHover {
+    handler: Rc<LinkHoverHandlerFn>,
+    current: Option<SharedString>,
+}
+
+impl Global for LinkHover {}
+
+/// Calls `handler` with the URL of the link under the pointer in any
+/// TextView of the app, and with `None` when the pointer leaves it, e.g. to
+/// show the URL in a status line. A later call replaces the handler.
+pub fn on_link_hover(
+    cx: &mut App,
+    handler: impl Fn(Option<SharedString>, &mut Window, &mut App) + 'static,
+) {
+    cx.set_global(LinkHover { handler: Rc::new(handler), current: None });
+}
+
+/// The pointer left the link `from` and entered `to` within one text.
+pub(crate) fn report_link_hover(
+    from: Option<SharedString>,
+    to: Option<SharedString>,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    if !cx.has_global::<LinkHover>() {
+        return;
+    }
+    let hover = cx.global_mut::<LinkHover>();
+    // A leave clears only the link it left: in the same move another text
+    // may already have reported entering its link.
+    if (to.is_none() && hover.current != from) || hover.current == to {
+        return;
+    }
+    hover.current = to.clone();
+    let handler = hover.handler.clone();
+    handler(to, window, cx);
+}
